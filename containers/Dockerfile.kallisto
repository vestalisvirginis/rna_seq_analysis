# --- Stage 1: Build kallisto and dependencies ---
FROM python:3.11-slim AS build

ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y \
    libgcc-s1 \
    libstdc++6 \
    wget \
    unzip \
    perl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tools
WORKDIR /tools
RUN wget https://github.com/pachterlab/kallisto/releases/download/v0.51.1/kallisto_linux-v0.51.1.tar.gz
RUN tar -xf kallisto_linux-v0.51.1.tar.gz
RUN rm -rf kallisto_linux-v0.51.1.tar.gz

# --- Stage 2: Minimal runtime with kallisto and dependencies ---
FROM python:3.11-slim AS runtime

ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    libgcc-s1 \
    libstdc++6 \
    wget \
    perl \
    parallel \
    && rm -rf /var/lib/apt/lists/*

# Copy kallisto binaries from build stage
COPY --from=build /tools/kallisto /tools/kallisto

ENV PATH="/tools/kallisto:$PATH"

RUN mkdir -p /app
WORKDIR /app
RUN pip install dagster-pipes toolz

VOLUME /scripts
VOLUME /inputs
VOLUME /indexes
VOLUME /outputs
